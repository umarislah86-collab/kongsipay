rules_version = '2';
// KongsiPay: users (uid/email identity immutable; own or shared-subscription profile),
// subscriptions (createdBy immutable owner; verified email self-admission only),
// billingCycles (subscriptionId immutable; owner financial fields; member revision only),
// payments (cycle/sub/member identity immutable; members submit pending only),
// paymentProofs (immutable image <=600000 chars; payer/owner only),
// providerProofs (owner image, visible to subscription members),
// userLookups (exact email -> uid, get only; no enumeration),
// profileAccess/{viewer}/members/{target} (verified shared subscription, no profile copy).
// Legacy games/results rules are preserved for other apps in this Firebase project.
service cloud.firestore {
  match /databases/{database}/documents {
    function utilitySpace(id){return get(/databases/$(database)/documents/utilitySpaces/$(id)).data;}
    function utilityMember(id){return signed() && request.auth.uid in utilitySpace(id).memberUids;}
    function validUtilitySpace(d){return d.keys().hasOnly(['name','createdBy','createdAt','memberUids','pendingEmails','profiles']) && text(d.name,100) && d.name.size()>0 && d.createdBy is string && d.createdAt is number && d.memberUids is list && d.memberUids.size()<=40 && d.createdBy in d.memberUids && d.pendingEmails is list && d.pendingEmails.size()<=40 && d.profiles is map && d.profiles.keys().hasOnly(d.memberUids);}
    function utilityFundChange(before,after,id){let e=getAfter(/databases/$(database)/documents/utilityItems/$(after.latestEntryId)).data;return after.diff(before).affectedKeys().hasOnly(['balance','revision','latestEntryId']) && after.revision==before.revision+1 && before.status=='active' && after.balance>=0 && e.kind=='entry' && e.fundId==id && e.spaceId==before.spaceId && e.createdBy==request.auth.uid && after.balance==before.balance+(e.entryType=='contribution'?e.amount:-e.amount) && (e.entryType=='contribution'||before.createdBy==request.auth.uid) && !exists(/databases/$(database)/documents/utilityItems/$(after.latestEntryId));}
    function validUtilityItem(d){return d.keys().hasOnly(['spaceId','kind','title','status','createdBy','createdAt','amount','participants','payer','shares','settled','target','quantity','fundId','entryType','balance','revision','latestEntryId','loanType','lender','borrower','returnedCents','dueDate','notes','returnLog','assignees','repeatDays','turn','completionLog','body','eventDate','pinned','readBy','eventId','assignee','batchId','completedBy','completedAt','hasAttachment']) && text(d.title,100) && d.title.size()>0 && d.createdBy is string && d.createdAt is number && d.status in ['active','done'] && d.kind in ['expense','fund','shopping','entry','loan','task','board','shoppingEvent'];}
    function utilityLoanChange(b,a){let e=a.returnLog[b.returnLog.size()];return b.lender==request.auth.uid && b.status=='active' && a.diff(b).affectedKeys().hasOnly(['returnedCents','status','returnLog']) && a.returnLog.size()==b.returnLog.size()+1 && a.returnLog.size()<=100 && a.returnLog.hasAll(b.returnLog) && e.by==request.auth.uid && e.at is number && e.id is string && ((b.loanType=='money' && a.returnedCents is int && a.returnedCents>b.returnedCents && a.returnedCents<=b.amount && e.amount==a.returnedCents-b.returnedCents && a.status==(a.returnedCents==b.amount?'done':'active')) || (b.loanType=='item' && a.returnedCents==0 && a.status=='done' && e.amount==0));}
    function utilityTaskChange(b,a){let e=a.completionLog[b.completionLog.size()];return b.status=='active' && request.auth.uid in [b.createdBy,b.assignees[b.turn]] && a.diff(b).affectedKeys().hasOnly(['completionLog','turn','dueDate','status']) && a.completionLog.size()==b.completionLog.size()+1 && a.completionLog.size()<=300 && a.completionLog.hasAll(b.completionLog) && e.by==request.auth.uid && e.assignedTo==b.assignees[b.turn] && e.at is number && e.id is string && (b.repeatDays==0 ? (a.status=='done' && a.turn==b.turn && a.dueDate==b.dueDate) : (a.status=='active' && a.turn==(b.turn+1)%b.assignees.size() && a.dueDate is string && a.dueDate>b.dueDate));}
    function utilityBoardChange(b,a){return (a.diff(b).affectedKeys().hasOnly(['readBy']) && a.readBy.toSet()==b.readBy.toSet().union([request.auth.uid].toSet())) || (a.diff(b).affectedKeys().hasOnly(['pinned']) && a.pinned is bool && (b.createdBy==request.auth.uid||utilitySpace(b.spaceId).createdBy==request.auth.uid)) || (b.createdBy==request.auth.uid && a.diff(b).affectedKeys().hasOnly(['title','body','eventDate','hasAttachment']) && text(a.body,2000) && text(a.eventDate,10));}
    function shoppingEvent(id){return get(/databases/$(database)/documents/utilityItems/$(id)).data;}
    function shoppingCreate(d){return text(d.quantity,100) && d.status=='active' && (!d.keys().hasAny(['eventId']) || (shoppingEvent(d.eventId).kind=='shoppingEvent' && shoppingEvent(d.eventId).spaceId==d.spaceId && shoppingEvent(d.eventId).createdBy==request.auth.uid && shoppingEvent(d.eventId).status=='active' && d.assignee in utilitySpace(d.spaceId).memberUids));}
    function shoppingChange(b,a){return !b.keys().hasAny(['eventId']) ? a.diff(b).affectedKeys().hasOnly(['status']) : (shoppingEvent(b.eventId).status=='active' && ((request.auth.uid in [b.assignee,shoppingEvent(b.eventId).createdBy] && a.diff(b).affectedKeys().hasOnly(['status','completedBy','completedAt','hasAttachment']) && (a.status=='done'?a.completedBy==request.auth.uid:a.completedBy=='') && a.completedAt is number) || (request.auth.uid==shoppingEvent(b.eventId).createdBy && b.status=='active' && a.assignee in utilitySpace(b.spaceId).memberUids && a.diff(b).affectedKeys().hasOnly(['assignee']))));}
    match /utilitySpaces/{id}{
      allow read: if signed() && (request.auth.uid in resource.data.memberUids || (verified() && email() in resource.data.pendingEmails));
      allow create: if verified() && validUtilitySpace(request.resource.data) && request.resource.data.createdBy==request.auth.uid && request.resource.data.memberUids==[request.auth.uid] && request.resource.data.pendingEmails.size()==0;
      allow update: if validUtilitySpace(request.resource.data) && ((resource.data.createdBy==request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','pendingEmails'])) || (verified() && email() in resource.data.pendingEmails && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids','pendingEmails','profiles']) && request.resource.data.memberUids.toSet()==resource.data.memberUids.toSet().union([request.auth.uid].toSet()) && request.resource.data.pendingEmails.toSet()==resource.data.pendingEmails.toSet().difference([email()].toSet()) && request.resource.data.profiles.diff(resource.data.profiles).affectedKeys().hasOnly([request.auth.uid])));
    }
    match /utilityItems/{id}{
      allow get: if signed() && (!exists(/databases/$(database)/documents/utilityItems/$(id)) || utilityMember(resource.data.spaceId));
      allow list: if utilityMember(resource.data.spaceId);
      allow create: if utilityMember(request.resource.data.spaceId) && validUtilityItem(request.resource.data) && (!request.resource.data.get('hasAttachment',false) || getAfter(/databases/$(database)/documents/utilityAttachments/$(id)).data.postId==id) && request.resource.data.createdBy==request.auth.uid && ((request.resource.data.kind=='loan' && request.resource.data.loanType in ['money','item'] && request.resource.data.lender in utilitySpace(request.resource.data.spaceId).memberUids && request.resource.data.borrower in utilitySpace(request.resource.data.spaceId).memberUids && request.resource.data.lender!=request.resource.data.borrower && request.resource.data.amount is int && (request.resource.data.loanType=='money'?request.resource.data.amount>0:request.resource.data.amount==0) && request.resource.data.returnedCents==0 && request.resource.data.returnLog==[] && request.resource.data.dueDate is string && request.resource.data.dueDate.size()==10 && text(request.resource.data.notes,2000) && text(request.resource.data.quantity,100) && request.resource.data.status=='active') || (request.resource.data.kind=='task' && request.resource.data.assignees is list && request.resource.data.assignees.size()>0 && request.resource.data.assignees.size()<=40 && request.resource.data.assignees.hasOnly(utilitySpace(request.resource.data.spaceId).memberUids) && request.resource.data.assignees.size()==request.resource.data.assignees.toSet().size() && request.resource.data.turn==0 && request.resource.data.repeatDays in [0,1,7,30] && request.resource.data.dueDate is string && request.resource.data.dueDate.size()==10 && request.resource.data.completionLog==[] && text(request.resource.data.notes,2000) && request.resource.data.status=='active') || (request.resource.data.kind=='board' && text(request.resource.data.body,2000) && text(request.resource.data.eventDate,10) && request.resource.data.pinned is bool && request.resource.data.readBy==[request.auth.uid] && request.resource.data.status=='active') || (request.resource.data.kind=='shopping' && shoppingCreate(request.resource.data)) || (request.resource.data.kind=='shoppingEvent' && text(request.resource.data.eventDate,10) && text(request.resource.data.notes,2000) && request.resource.data.revision==0 && request.resource.data.status=='active') || (request.resource.data.kind=='fund' && request.resource.data.target is int && request.resource.data.target>0 && request.resource.data.balance==0 && request.resource.data.revision==0 && request.resource.data.status=='active') || (request.resource.data.kind=='expense' && request.resource.data.amount is int && request.resource.data.amount>0 && request.resource.data.participants is list && request.resource.data.participants.size()>0 && request.resource.data.participants.size()<=40 && request.resource.data.participants.hasOnly(utilitySpace(request.resource.data.spaceId).memberUids) && request.resource.data.payer in request.resource.data.participants && request.resource.data.shares is map && request.resource.data.shares.keys().toSet()==request.resource.data.participants.toSet() && request.resource.data.settled==[request.resource.data.payer] && request.resource.data.status=='active') || (request.resource.data.kind=='entry' && request.resource.data.amount is int && request.resource.data.amount>0 && request.resource.data.status=='done' && request.resource.data.entryType in ['contribution','withdrawal'] && get(/databases/$(database)/documents/utilityItems/$(request.resource.data.fundId)).data.kind=='fund' && get(/databases/$(database)/documents/utilityItems/$(request.resource.data.fundId)).data.spaceId==request.resource.data.spaceId && getAfter(/databases/$(database)/documents/utilityItems/$(request.resource.data.fundId)).data.latestEntryId==id && utilityFundChange(get(/databases/$(database)/documents/utilityItems/$(request.resource.data.fundId)).data,getAfter(/databases/$(database)/documents/utilityItems/$(request.resource.data.fundId)).data,request.resource.data.fundId)));
      allow update: if utilityMember(resource.data.spaceId) && validUtilityItem(request.resource.data) && (!request.resource.data.get('hasAttachment',false) || getAfter(/databases/$(database)/documents/utilityAttachments/$(id)).data.postId==id) && ((resource.data.kind=='shopping' && shoppingChange(resource.data,request.resource.data)) || (resource.data.kind=='shoppingEvent' && resource.data.createdBy==request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','revision'])) || (resource.data.kind in ['expense','fund','task','board'] && resource.data.createdBy==request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) || (resource.data.kind=='expense' && resource.data.payer==request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settled']) && request.resource.data.settled.hasAll(resource.data.settled) && request.resource.data.settled.hasOnly(resource.data.participants)) || (resource.data.kind=='fund' && utilityFundChange(resource.data,request.resource.data,id)) || (resource.data.kind=='loan' && utilityLoanChange(resource.data,request.resource.data)) || (resource.data.kind=='task' && utilityTaskChange(resource.data,request.resource.data)) || (resource.data.kind=='board' && utilityBoardChange(resource.data,request.resource.data)));
    }
    match /utilityAttachments/{id}{
      allow get: if signed() && utilityMember(shoppingEvent(id).spaceId);
      allow create,update: if utilityMember(request.resource.data.spaceId) && request.resource.data.keys().hasOnly(['name','kind','dataUrl','postId','spaceId','createdBy','createdAt']) && text(request.resource.data.name,80) && request.resource.data.postId==id && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt is number && request.resource.data.dataUrl is string && request.resource.data.dataUrl.size()<=600000 && ((request.resource.data.kind=='image' && request.resource.data.dataUrl.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/]+=*')) || (request.resource.data.kind=='file' && request.resource.data.dataUrl.matches('data:application/octet-stream;base64,[A-Za-z0-9+/]+=*'))) && getAfter(/databases/$(database)/documents/utilityItems/$(id)).data.kind=='board' && getAfter(/databases/$(database)/documents/utilityItems/$(id)).data.createdBy==request.auth.uid && getAfter(/databases/$(database)/documents/utilityItems/$(id)).data.spaceId==request.resource.data.spaceId && getAfter(/databases/$(database)/documents/utilityItems/$(id)).data.hasAttachment==true;
      allow delete: if shoppingEvent(id).createdBy==request.auth.uid && utilityMember(shoppingEvent(id).spaceId) && getAfter(/databases/$(database)/documents/utilityItems/$(id)).data.hasAttachment==false;
    }
    function signed(){return request.auth != null;}
    function verified(){return signed() && request.auth.token.get('email_verified',false) == true;}
    function email(){return request.auth.token.get('email','').lower();}
    function sub(id){return get(/databases/$(database)/documents/subscriptions/$(id)).data;}
    function member(id){return signed() && request.auth.uid in sub(id).memberUids;}
    function owner(id){return signed() && sub(id).createdBy == request.auth.uid;}
    function text(v,max){return v is string && v.size() <= max;}
    function number(v){return v is number && v >= 0 && v <= 1000000;}
    function validUser(d,uid){return d.keys().hasOnly(['uid','name','email','photoURL','createdAt','whatsappNo','qrUrl']) && d.uid == uid && text(d.name,150) && text(d.email,254) && d.createdAt is number && text(d.get('photoURL',''),2048) && text(d.get('whatsappNo',''),25) && text(d.get('qrUrl',''),650000);}
    function sharedProfile(uid){let grant=get(/databases/$(database)/documents/profileAccess/$(request.auth.uid)/members/$(uid)).data;return member(grant.subscriptionId) && uid in sub(grant.subscriptionId).memberUids;}
    function validSub(d){return d.keys().hasOnly(['name','description','iconEmoji','iconKey','iconColor','billingType','memberUids','pendingEmails','createdBy','createdAt','currency','kongsipay','kongsipayRevision']) && text(d.name,60) && d.name.size()>0 && text(d.get('description',''),500) && text(d.get('iconEmoji',''),16) && text(d.get('iconKey',''),24) && text(d.get('iconColor',''),24) && d.billingType in ['split','rotation','hutang'] && text(d.createdBy,128) && d.memberUids is list && d.memberUids.size() >= 1 && d.memberUids.size() <= 50 && d.memberUids.toSet().size() == d.memberUids.size() && d.createdBy in d.memberUids && d.get('pendingEmails',[]) is list && d.get('pendingEmails',[]).size() <= 50 && d.memberUids.size()+d.get('pendingEmails',[]).size() <= 50 && d.get('createdAt',0) is number && d.get('currency','RM') == 'RM' && d.get('kongsipay',{}) is map && d.get('kongsipayRevision',0) is int;}
    function selfAdmission(before,after){return verified() && email() in before.get('pendingEmails',[]) && after.diff(before).affectedKeys().hasOnly(['memberUids','pendingEmails']) && after.memberUids.toSet() == before.memberUids.toSet().union([request.auth.uid].toSet()) && after.get('pendingEmails',[]).toSet() == before.get('pendingEmails',[]).toSet().difference([email()].toSet());}
    function validCycle(d){return d.keys().hasOnly(['subscriptionId','label','startDate','endDate','dueDate','totalAmount','perPersonAmount','payerUid','createdAt','memberUids','shareAmountsCents','payeeUid','providerPaid','providerPaidAt','providerAmountCents','providerPaidBy','hasProviderProof','frequency','source','excludeProviderShare','superseded','refinanceRequest','kongsipayRevision']) && text(d.subscriptionId,128) && text(d.label,150) && text(d.startDate,10) && text(d.endDate,10) && number(d.totalAmount) && number(d.perPersonAmount) && d.createdAt is number && text(d.get('payerUid',''),128) && text(d.get('payeeUid',''),128) && text(d.get('dueDate',''),10) && d.get('memberUids',[]) is list && d.get('memberUids',[]).size()<=50 && d.get('shareAmountsCents',{}) is map && d.get('shareAmountsCents',{}).size()<=50 && d.get('providerAmountCents',1) is int && d.get('providerAmountCents',1)>0 && d.get('providerAmountCents',1)<=100000000 && d.get('providerPaid',false) is bool && d.get('hasProviderProof',false) is bool && d.get('superseded',false) is bool && d.get('kongsipayRevision',0) is int && d.get('kongsipayRevision',0)>=0;}
    function validPayment(d){return d.keys().hasOnly(['cycleId','subscriptionId','memberUid','amount','amountCents','paid','partialPayment','isSedekah','status','method','reference','submittedBy','createdAt','paidAt','source','hasProof','bulkRequestId','reviewedBy','reviewedAt','rejectionReason','reversedBy','reversedAt','settlementMarker','rescheduleMarker']) && text(d.cycleId,220) && text(d.subscriptionId,128) && text(d.memberUid,128) && number(d.amount) && d.paid is bool && d.get('partialPayment',false) is bool && d.get('isSedekah',false) is bool && d.get('hasProof',false) is bool && d.get('status','') in ['','pending','approved','rejected','reversed','forgiven','rescheduled'] && text(d.get('reference',''),160) && text(d.get('rejectionReason',''),160) && text(d.get('method',''),30) && d.get('createdAt',0) is number && (d.get('paidAt',0) is number || d.get('paidAt',0)==null);}
    function pendingPayment(d){let cycle=get(/databases/$(database)/documents/billingCycles/$(d.cycleId)).data;let shares=cycle.get('shareAmountsCents',{});let limit=shares.get(d.memberUid,cycle.perPersonAmount*100);return member(d.subscriptionId) && d.memberUid == request.auth.uid && d.submittedBy == request.auth.uid && cycle.subscriptionId == d.subscriptionId && cycle.get('superseded',false) == false && (sub(d.subscriptionId).billingType == 'split' ? d.memberUid in cycle.get('memberUids',sub(d.subscriptionId).memberUids) : cycle.payerUid == d.memberUid) && d.status == 'pending' && d.paid == false && d.partialPayment == false && d.isSedekah == false && d.amount > 0 && d.amount <= limit / 100.0 && d.method in ['Bank transfer','DuitNow','E-wallet','Cash'] && d.source == 'kongsipay' && !d.keys().hasAny(['reviewedBy','reviewedAt','paidAt','rejectionReason','reversedBy','reversedAt','settlementMarker','rescheduleMarker']) && getAfter(/databases/$(database)/documents/billingCycles/$(d.cycleId)).data.get('kongsipayRevision',0) == cycle.get('kongsipayRevision',0)+1;}
    function proofEditor(p){return owner(p.subscriptionId) || (member(p.subscriptionId) && p.memberUid==request.auth.uid && p.get('submittedBy','')==request.auth.uid && p.get('status','')=='pending');}
    function validProof(d){return text(d.dataUrl,600000) && d.dataUrl.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/]+={0,2}') && text(d.name,80) && d.createdAt is number && text(d.subscriptionId,128) && text(d.cycleId,220);}
    match /users/{uid} {
      allow get: if signed() && (request.auth.uid == uid || sharedProfile(uid));
      allow create: if verified() && request.auth.uid == uid && validUser(request.resource.data,uid) && request.resource.data.email.lower() == email();
      allow update: if verified() && request.auth.uid == uid && validUser(request.resource.data,uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid','email','createdAt']);
      allow delete: if false;
    }
    match /userLookups/{lookup} {
      allow get: if verified();
      allow create,update: if verified() && lookup == email() && request.resource.data.keys().hasOnly(['uid','email']) && request.resource.data.uid == request.auth.uid && request.resource.data.email == email();
    }
    match /profileAccess/{viewer}/members/{target} {
      allow get: if signed() && request.auth.uid == viewer;
      allow create,update: if signed() && request.auth.uid == viewer && request.resource.data.keys().hasOnly(['subscriptionId']) && member(request.resource.data.subscriptionId) && target in sub(request.resource.data.subscriptionId).memberUids;
      allow delete: if signed() && request.auth.uid == viewer;
    }
    match /subscriptions/{id} {
      allow read: if signed() && (request.auth.uid in resource.data.memberUids || (verified() && email() in resource.data.get('pendingEmails',[])));
      allow create: if verified() && validSub(request.resource.data) && request.resource.data.createdBy == request.auth.uid;
      allow update: if signed() && validSub(request.resource.data) && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.get('createdAt',0) == resource.data.get('createdAt',0) && (resource.data.createdBy == request.auth.uid || selfAdmission(resource.data,request.resource.data));
      allow delete: if signed() && resource.data.createdBy == request.auth.uid;
    }
    match /billingCycles/{id} {
      allow get: if signed() && (!exists(/databases/$(database)/documents/billingCycles/$(id)) || member(resource.data.subscriptionId));
      allow list: if member(resource.data.subscriptionId);
      allow create: if validCycle(request.resource.data) && owner(request.resource.data.subscriptionId);
      allow update: if validCycle(request.resource.data) && request.resource.data.subscriptionId == resource.data.subscriptionId && (owner(resource.data.subscriptionId) || (member(resource.data.subscriptionId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kongsipayRevision']) && request.resource.data.kongsipayRevision == resource.data.get('kongsipayRevision',0)+1));
      allow delete: if owner(resource.data.subscriptionId);
    }
    match /payments/{id} {
      allow get: if signed() && (!exists(/databases/$(database)/documents/payments/$(id)) || member(resource.data.subscriptionId));
      allow list: if member(resource.data.subscriptionId);
      allow create: if validPayment(request.resource.data) && (owner(request.resource.data.subscriptionId) || pendingPayment(request.resource.data)) && (request.resource.data.get('hasProof',false) == false || getAfter(/databases/$(database)/documents/paymentProofs/$(id)).data.paymentId == id);
      allow update: if validPayment(request.resource.data) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['cycleId','subscriptionId','memberUid','createdAt']) && (owner(resource.data.subscriptionId) || (proofEditor(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasProof']))) && (request.resource.data.get('hasProof',false)==false || getAfter(/databases/$(database)/documents/paymentProofs/$(id)).data.paymentId==id);
      allow delete: if owner(resource.data.subscriptionId);
    }
    match /paymentProofs/{id} {
      allow get: if signed() && (!exists(/databases/$(database)/documents/paymentProofs/$(id)) || (member(resource.data.subscriptionId) && (resource.data.memberUid == request.auth.uid || owner(resource.data.subscriptionId))));
      allow create,update: if validProof(request.resource.data) && request.resource.data.keys().hasOnly(['dataUrl','name','paymentId','subscriptionId','cycleId','memberUid','submittedBy','createdAt']) && request.resource.data.paymentId == id && request.resource.data.submittedBy == request.auth.uid && proofEditor(getAfter(/databases/$(database)/documents/payments/$(id)).data) && getAfter(/databases/$(database)/documents/payments/$(id)).data.memberUid == request.resource.data.memberUid && getAfter(/databases/$(database)/documents/payments/$(id)).data.subscriptionId == request.resource.data.subscriptionId && getAfter(/databases/$(database)/documents/payments/$(id)).data.cycleId == request.resource.data.cycleId && getAfter(/databases/$(database)/documents/payments/$(id)).data.hasProof == true;
      allow delete: if proofEditor(get(/databases/$(database)/documents/payments/$(id)).data);
    }
    match /providerProofs/{id} {
      allow get: if signed() && (!exists(/databases/$(database)/documents/providerProofs/$(id)) || member(resource.data.subscriptionId));
      allow create,update: if validProof(request.resource.data) && request.resource.data.keys().hasOnly(['dataUrl','name','subscriptionId','cycleId','submittedBy','createdAt']) && request.resource.data.cycleId == id && request.resource.data.submittedBy == request.auth.uid && owner(request.resource.data.subscriptionId) && getAfter(/databases/$(database)/documents/billingCycles/$(id)).data.subscriptionId == request.resource.data.subscriptionId && getAfter(/databases/$(database)/documents/billingCycles/$(id)).data.hasProviderProof == true;
      allow delete: if owner(resource.data.subscriptionId);
    }
    match /games/{gameId} { allow read,write: if true; }
    match /results/{resultId} { allow read,write: if true; }
  }
}

